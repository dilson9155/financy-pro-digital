# =============================================================================
# Financy Pro Digital - variaveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env real.
# =============================================================================

# --- Banco de dados (Neon PostgreSQL) -----------------------------------------
# Connection string com pooling (PgBouncer) usada pela aplicacao em runtime.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.regiao.aws.neon.tech/financy?sslmode=require&pgbouncer=true&connect_timeout=15"
# Conexao direta (sem pooler) usada por migrations e pelo seed.
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.regiao.aws.neon.tech/financy?sslmode=require"

# --- Aplicacao ----------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Financy Pro Digital"

# --- Autenticacao / Sessao ----------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="troque-por-uma-chave-aleatoria-de-48-bytes-em-hex"
AUTH_COOKIE_NAME="financy_session"
SESSION_MAX_AGE_HOURS="12"

# --- Seguranca ----------------------------------------------------------------
# Numero de tentativas de login antes do bloqueio temporario.
AUTH_MAX_LOGIN_ATTEMPTS="5"
AUTH_LOCK_MINUTES="15"

# --- Backups ------------------------------------------------------------------
# Diretorio onde os backups logicos (JSON/SQL) sao gravados em runtime.
BACKUP_DIR="./storage/backups"

# --- Seed (opcional) -----------------------------------------------------------
# Credenciais do administrador de sistema criado pelo seed (idempotente).
# Em producao use valores fortes e rode SEM SEED_DEMO_DATA.
SEED_ADMIN_EMAIL="admin@financy.local"
SEED_ADMIN_NAME="Administrador do Sistema"
# Troque esta senha padrao em qualquer ambiente.
SEED_ADMIN_PASSWORD="admin123456"
# Apenas desenvolvimento/QA: "true" cria empresa demo com dados de exemplo.
SEED_DEMO_DATA="false"
SEED_DEMO_COMPANY="Empresa Demo LTDA"

# --- Recuperacao de senha (e-mail via Resend) ---------------------------------
# Crie a API key em https://resend.com e verifique o dominio remetente.
# Sem a chave, o link de redefinicao e apenas registrado no log do servidor.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Financy Pro Digital <no-reply@elitesistemas.io>"
# URL publica da logo usada no e-mail (opcional; padrao: ${APP_URL}/logo.png).
EMAIL_LOGO_URL=""
# Apenas desenvolvimento: devolve o link de redefinicao na resposta da API.
PASSWORD_RESET_DEV_LINK="false"
